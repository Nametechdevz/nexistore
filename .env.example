# ===== NexiStore — variables de entorno =====
# Copia este archivo como .env (local) o define las variables en el panel de Hostinger.
# NUNCA subas el archivo .env al repositorio.

NODE_ENV=production
PORT=3000
# URL pública de la tienda (sin barra final). Se usa en enlaces de correo, OAuth y pasarelas.
APP_URL=https://tu-dominio.com
# true si la app corre detrás de un proxy (Hostinger lo hace): habilita cookies seguras correctas.
TRUST_PROXY=true

# --- Base de datos MySQL / MariaDB (Hostinger → Bases de datos → MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Primer administrador (se crea al arrancar si no existe ninguno; luego borra ADMIN_PASSWORD) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Carga el catálogo de ejemplo si la base está vacía (solo para probar)
SEED_DEMO=false

# Días que dura la sesión con "Recordarme"
SESSION_DAYS=30

# --- Correo SMTP (recuperación de contraseña). Hostinger: smtp.hostinger.com:465 ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="NexiStore <no-reply@tu-dominio.com>"

# --- Inicio de sesión con Google (opcional) ---
# URI de redirección autorizada: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Mercado Pago (Checkout Pro). Vacío = "pendiente de configuración" ---
# Webhook: {APP_URL}/api/payments/webhooks/mercadopago  (evento: Pagos)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# --- Wompi (Nequi, Bancolombia, PSE). Vacío = "pendiente de configuración" ---
# URL de eventos: {APP_URL}/api/payments/webhooks/wompi
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# --- Zenobank (criptomonedas: USDT, USDC, BTC…). Vacío = "pendiente de configuración" ---
# Dashboard Zenobank → Developers: API key (sk_…) y webhook (secreto whsec_…).
# URL del webhook: {APP_URL}/api/payments/webhooks/zenobank  (eventos: checkout.completed, checkout.expired, checkout.partially_paid)
# Moneda de cotización (USD por defecto). Con USD/EUR define la tasa en Configuración → Criptomonedas.
ZENOBANK_API_KEY=
ZENOBANK_WEBHOOK_SECRET=
ZENOBANK_PRICE_CURRENCY=USD

# --- Inventario de cuentas: llave para cifrar credenciales (AES-256-GCM) ---
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ¡Guárdala en un lugar seguro! Sin ella no se pueden leer las credenciales ya guardadas.
INVENTORY_ENCRYPTION_KEY=

# --- Transferencia con verificación manual por un administrador ---
MANUAL_PAYMENTS_ENABLED=false
