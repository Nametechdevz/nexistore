# ===== NexiStore — instalación =====
# Solo necesitas la base de datos y el primer administrador.
# Pagos (Wompi, Mercado Pago, Zenobank, transferencias), correo SMTP, Google y la URL de la tienda
# se configuran después en Admin → Configuración → «Pagos, correo y acceso».
# Copia este archivo como .env (local) o define las variables en el panel de Hostinger.
# NUNCA subas el archivo .env al repositorio.

# --- Base de datos MySQL / MariaDB (Hostinger → Bases de datos → MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Primer administrador (se crea al arrancar si no existe ninguno) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Opcional: carga el catálogo de ejemplo si la base está vacía
# SEED_DEMO=true
