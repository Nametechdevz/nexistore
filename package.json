{
  "name": "nexistore",
  "version": "1.0.0",
  "private": true,
  "description": "NexiStore — tienda y marketplace de productos digitales",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/node/server/index.js",
    "db:migrate": "tsx server/cli/migrate.ts",
    "db:seed": "tsx server/cli/seed.ts",
    "admin:create": "tsx server/cli/create-admin.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "e2e": "node tests/e2e/run.mjs",
    "package:hostinger": "node scripts/package-hostinger.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.57.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
